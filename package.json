{
  "name": "typeorm-monorepo",
  "version": "1.1.3",
  "private": true,
  "description": "Workspace root for the TypeORM repository",
  "repository": {
    "type": "git",
    "url": "https://github.com/typeorm/typeorm.git"
  },
  "license": "MIT",
  "scripts": {
    "changelog": "standard-changelog",
    "check:manifests": "node scripts/check-publishable-manifests.mjs",
    "compile": "pnpm --filter typeorm run compile",
    "docs:dev": "cd docs && pnpm run start",
    "format": "prettier --cache --write .",
    "format:ci": "prettier --check .",
    "lint": "pnpm -r run lint",
    "package": "pnpm --filter typeorm run package",
    "prepare": "husky",
    "test": "pnpm --filter typeorm run test",
    "test:fast": "pnpm --filter typeorm run test:fast",
    "typecheck": "pnpm --filter typeorm run typecheck",
    "watch": "pnpm --filter typeorm run watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node20": "^20.1.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-jsdoc": "^65.4.6",
    "eslint-plugin-unicorn": "^79.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "pkg-pr-new": "^0.0.93",
    "prettier": "^3.10.1",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-toml": "^4.1.0",
    "standard-changelog": "^8.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.11.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^10.34.9",
      "onFail": "error"
    }
  }
}
